{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "scripts",
    "outDir": "scripts/dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmitOnError": false,
    "declaration": false
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["scripts/dist", "node_modules"]
}
