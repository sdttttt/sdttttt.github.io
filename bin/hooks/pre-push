#!/usr/bin/env bash
#
# pre-push hook（由 bin/install-hooks.sh 通过 core.hooksPath 启用）。
#
# push 前跑一次只读 preflight：本地如果和「CI 会产出的结果」不一致，就在这里失败，
# 而不是等 CI 推回来一个 `chore: auto-fix content` 提交 —— 那才是历史被搅乱的原因
# （2026-08-23 的 `0a651bd` 误改 230 个文件、10-04 的 225 个文件改名都是这么来的）。
#
# 只读、不改文件；慢一点（本仓库约几秒），但只在 push 时跑一次。
# 绕过（AGENTS.md 里属于需要确认的动作）：git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if [ ! -x "$ROOT/.tools/deno/bin/deno" ] && ! command -v deno >/dev/null 2>&1; then
  echo "  ~~  跳过 preflight：找不到 deno（本机应有 .tools/deno/bin/deno）" >&2
  exit 0
fi

exec "$ROOT/bin/preflight.sh" --check
