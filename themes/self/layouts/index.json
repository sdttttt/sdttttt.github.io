{{/*
  Search index — the home page's JSON output format (hugo.toml defines it),
  published as /searchindex.json and fetched by /search/
  (themes/self/layouts/_default/search.html + assets/js/search.js).

  One entry per post. The text is pre-flattened at build time (plainify drops
  the markup, htmlUnescape turns `&amp;` back into `&`, strings.TrimSpace
  trims Go's leftover newlines) and the body is cut short — the full plain
  text of 209 posts would be several megabytes, and a search index nobody
  waits for helps nobody. Title / tags / date / summary are searched too.

  Only `site.Params.mainSections` (= posts): the same filter the theme's own
  post navigation uses, so changelog entries and other sections stay out.
  Drafts and future-dated posts never reach a template.

  Search behaviour (weights, AND/OR fallback) lives in assets/js/search.js.
*/}}
{{- $pages := where site.RegularPages "Type" "in" site.Params.mainSections -}}
{{- $index := slice -}}
{{- range $pages -}}
  {{- $body := .Plain | htmlUnescape | strings.TrimSpace -}}
  {{- if gt (strings.RuneCount $body) 500 -}}
    {{- $body = substr $body 0 500 -}}
  {{- end -}}
  {{- $summary := .Summary | plainify | htmlUnescape | strings.TrimSpace -}}
  {{- if gt (strings.RuneCount $summary) 300 -}}
    {{- $summary = substr $summary 0 300 -}}
  {{- end -}}
  {{- $index = $index | append (dict
        "title" .Title
        "url" .RelPermalink
        "date" (.Date.Format "2006-01-02")
        "tags" (.Params.tags | default slice)
        "summary" $summary
        "body" $body) -}}
{{- end -}}
{{- $index | jsonify -}}
