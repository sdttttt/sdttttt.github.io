{
  "name": "self",
  "version": "1.0.0",
  "private": true,
  "description": "UnoCSS toolchain for the `self` Hugo theme: `bun run build:css` compiles assets/app.css into assets/main.css.",
  "license": "MIT",
  "scripts": {
    "build:css": "postcss ./assets/app.css -o ./assets/main.css"
  },
  "devDependencies": {
    "@unocss/postcss": "^66.11.0",
    "@unocss/preset-typography": "^66.11.0",
    "@unocss/preset-wind4": "^66.11.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-preset-env": "^11.1.2",
    "prettier": "^3.8.1",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "unocss": "^66.11.0"
  }
}
