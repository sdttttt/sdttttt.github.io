# Dependencies
node_modules/

# Hugo build
public/
.hugo_build.lock
hugo_stats.json

# OS
.DS_Store

# Claude Code 的本机配置（settings.local.json / launch.json 等只服务于
# 本地会话，不属于仓库内容）
.claude/

# Local toolchain leftovers from the Deno era (no longer used; kept so an
# existing checkout does not start tracking them)
.tools/
.npm-cache/

# Scripts: Node runs .ts directly (native type stripping), so scripts/dist/ is a
# dead artifact from an old compile-to-JS snapshot. Never commit it.
scripts/dist/

# Rust/WASM build artifacts (the built particles.wasm is committed under
# themes/self/assets/wasm/, only the cargo target dir is ignored)
wasm/**/target/
