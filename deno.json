{
  "tasks": {
    "test": "deno test -A scripts/__tests__/**/*.test.ts",
    "validate-posts": "deno run -A scripts/validate-posts.ts",
    "check-dead-links": "deno run -A scripts/check-dead-links.ts",
    "format-markdown": "deno run -A scripts/format-markdown.ts",
    "format-markdown-check": "deno run -A scripts/format-markdown.ts --check",
    "sync-covers": "deno run -A scripts/sync-covers.ts",
    "sync-covers-dry": "deno run -A scripts/sync-covers.ts --dry-run",
    "gen-covers": "deno run -A scripts/gen-covers.ts",
    "rename-posts": "deno run -A scripts/rename-posts.ts",
    "rename-posts-dry": "deno run -A scripts/rename-posts.ts --dry-run",
    "optimize-images": "deno run -A scripts/optimize-images.ts",
    "git-commit-push": "deno run -A scripts/git-commit-push.ts",
    "git-commit-push-dry": "deno run -A scripts/git-commit-push.ts --dry-run"
  },
  "unstable": ["sloppy-imports"],
  "imports": {
    "sharp": "npm:sharp@0.33.5"
  },
  "exclude": ["scripts/dist", "themes/PaperMod", ".tools", ".npm-cache"],
  "nodeModulesDir": "none"
}